# Example Configuration for Redis Cloud
# Copy this to .env and update YOUR_PASSWORD

# API Configuration
API_KEYS=sk_prod_example_key_replace_in_production,sk_test_another_valid_key_replace_in_production

# Redis Cloud Configuration
ENABLE_REDIS=true

# Redis Cloud Instance (with SSL/TLS - recommended)
REDIS_URL=rediss://default:YOUR_PASSWORD@everlasting-kittenish-sneeze-82380.db.redis.io:12512/0

# Without SSL (not recommended for production)
# REDIS_URL=redis://default:YOUR_PASSWORD@everlasting-kittenish-sneeze-82380.db.redis.io:12512/0

REDIS_MAX_CONNECTIONS=50
CACHE_TTL_SECONDS=3600

# Gateway Configuration
INTERNAL_GATEWAY_URL=https://terabox.com
FIXED_APP_ID=250528

# Rate Limiting
RATE_LIMIT_PER_MINUTE=10

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=4
LOG_LEVEL=info

# Security
ALLOWED_ORIGINS=*
ENABLE_CORS=false

# INSTRUCTIONS:
# 1. Copy this file: cp .env.redis-cloud .env
# 2. Replace YOUR_PASSWORD with your actual Redis Cloud password
# 3. Get password from: https://app.redislabs.com
# 4. Run: python main.py
