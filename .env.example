# API Configuration
API_KEYS=sk_prod_example_key_replace_in_production,sk_test_another_valid_key_replace_in_production

# Redis Configuration
ENABLE_REDIS=true                # Set to 'false' to disable Redis caching for local testing

# Local Redis (default)
REDIS_URL=redis://localhost:6379/0

# Redis Cloud / External Redis (with authentication)
# Format: redis://username:password@host:port/db
# Example: redis://default:your_password@everlasting-kittenish-sneeze-82380.db.redis.io:12512/0
# Or use rediss:// for SSL/TLS: rediss://default:password@host:port/db

REDIS_PASSWORD=                  # Optional: Redis password (if not in URL)
REDIS_MAX_CONNECTIONS=50
CACHE_TTL_SECONDS=3600

# Gateway Configuration
INTERNAL_GATEWAY_URL=https://terabox.com
FIXED_APP_ID=250528

# Rate Limiting
RATE_LIMIT_PER_MINUTE=10

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=4
LOG_LEVEL=info

# Security
ALLOWED_ORIGINS=*
ENABLE_CORS=false
